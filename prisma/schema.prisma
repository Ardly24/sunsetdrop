// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  BUSINESS
  CHARITY
  ADMIN
}

enum BusinessType {
  RESTAURANT
  BAKERY
  SUPERMARKET
  GROCERY_STORE
  OTHER
}

enum ListingType {
  DISCOUNTED
  DONATION
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  EXPIRED
  CANCELLED
}

enum FoodCategory {
  BAKERY
  PREPARED_MEALS
  FRUITS_VEGETABLES
  DAIRY
  MEAT_SEAFOOD
  GROCERIES
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  COLLECTED
  CANCELLED
}

enum NotificationType {
  RESERVATION_CREATED
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  RESERVATION_COLLECTED
  DONATION_AVAILABLE
  DONATION_CLAIMED
  SYSTEM
}

enum NotificationEmailStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String
  passwordHash String

  address   String?
  suburb    String?
  city      String?
  country   String   @default("South Africa")

  role         UserRole
  emailNotificationsEnabled Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch       Branch?
  charity Charity?
  customerReservations Reservation[]
  notifications Notification[]
}

model Business {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String
  description String?
  website     String?
  type        BusinessType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  branches Branch[]
}


model Branch {
  id        String   @id @default(cuid())
  businessId String
  userId    String   @unique

  name      String
  address   String
  suburb    String?
  city      String
  country   String   @default("South Africa")
  latitude  Float?
  longitude Float?

  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  listings Listing[]
}


model Charity {
  id        String   @id @default(cuid())
  userId    String   @unique

  name      String
  email     String
  phone     String
  description String?
  website     String?

  address   String
  suburb    String?
  city      String
  country   String   @default("South Africa")

  latitude  Float?
  longitude Float?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model Listing {
  id          String        @id @default(cuid())
  branchId    String

  title       String
  description String?
  category    FoodCategory

  type        ListingType   @default(DISCOUNTED)
  status      ListingStatus @default(ACTIVE)

  price       Decimal       @default(0) @db.Decimal(10, 2)
  originalPrice Decimal?    @db.Decimal(10, 2)

  quantityAvailable Int
  quantitySold      Int     @default(0)

  weightPerItemKg Decimal?  @db.Decimal(8, 3)

  imageUrl String?
  images ListingImage[]

  expiresAt         DateTime?
  collectionStartsAt DateTime
  collectionEndsAt   DateTime

  ingredients           String?
  allergens             String
  storageInstructions   String?
  collectionInstructions String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([status])
  @@index([type])
  @@index([collectionEndsAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  fileId    String   @unique
  url       String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, sortOrder])
  @@index([listingId])
}

model Reservation {
  id             String            @id @default(cuid())
  customerId     String
  listingId      String
  quantity       Int
  collectionTime DateTime
  status         ReservationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collectionTokenHash       String?   @unique
  collectionTokenExpiresAt DateTime?
  collectedAt               DateTime?

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([listingId])
  @@index([status])
  @@index([collectionTime])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType

  title     String
  message   String
  link      String?

  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     NotificationEmail?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationEmail {
  id             String                 @id @default(cuid())
  notificationId String                 @unique

  status         NotificationEmailStatus @default(PENDING)
  attempts       Int                    @default(0)

  sentAt         DateTime?
  lastError      String?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  notification  Notification            @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}