// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  BUSINESS
  CHARITY
  ADMIN
}

enum BusinessType {
  RESTAURANT
  BAKERY
  SUPERMARKET
  GROCERY_STORE
  OTHER
}

enum ListingType {
  DISCOUNTED
  DONATION
}

enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  EXPIRED
}

enum FoodCategory {
  BAKERY
  PREPARED_MEALS
  FRUITS_VEGETABLES
  DAIRY
  MEAT_SEAFOOD
  GROCERIES
  OTHER
}


model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String
  passwordHash String

  address   String?
  suburb    String?
  city      String?
  country   String   @default("South Africa")

  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch       Branch?
  charity Charity?
}

model Business {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String
  description String?
  website     String?
  type        BusinessType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  branches Branch[]
}


model Branch {
  id        String   @id @default(cuid())
  businessId String
  userId    String   @unique

  name      String
  address   String
  suburb    String?
  city      String
  country   String   @default("South Africa")
  latitude  Float?
  longitude Float?

  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  listings Listing[]
}


model Charity {
  id        String   @id @default(cuid())
  userId    String   @unique

  name      String
  email     String
  phone     String
  description String?
  website     String?

  address   String
  suburb    String?
  city      String
  country   String   @default("South Africa")

  latitude  Float?
  longitude Float?

  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

model Listing {
  id          String        @id @default(cuid())
  branchId    String

  title       String
  description String?
  category    FoodCategory

  type        ListingType   @default(DISCOUNTED)
  status      ListingStatus @default(ACTIVE)

  price       Decimal       @default(0) @db.Decimal(10, 2)
  originalPrice Decimal?    @db.Decimal(10, 2)

  quantityAvailable Int
  quantitySold      Int     @default(0)

  weightPerItemKg Decimal?  @db.Decimal(8, 3)

  imageUrl String?

  expiresAt         DateTime?
  collectionStartsAt DateTime
  collectionEndsAt   DateTime

  ingredients           String?
  allergens             String
  storageInstructions   String?
  collectionInstructions String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([status])
  @@index([type])
  @@index([collectionEndsAt])
}